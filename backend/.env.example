PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/contractiq

# JWT
JWT_SECRET=contractiq_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Storage
FILE_STORAGE_URL=http://localhost:5000/uploads
MAX_FILE_SIZE_MB=15

# Groq AI API Key (required for AI contract analysis)
GROQ_API_KEY=gsk_your_groq_api_key_here

# n8n Integration Webhooks (optional — backend falls back to direct Groq if not set)
N8N_DOCUMENT_ANALYSIS_WEBHOOK=http://localhost:5678/webhook/contractiq-analyze
N8N_REPORT_WEBHOOK=http://localhost:5678/webhook/contractiq-report

# SMTP Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ContractIQ Alerts <noreply@contractiq.com>
