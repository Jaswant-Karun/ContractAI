# Root Environment Configuration Example for ContractIQ

# Backend configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/contractiq
JWT_SECRET=contractiq_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Storage configuration
FILE_STORAGE_URL=http://localhost:5000/uploads
MAX_FILE_SIZE_MB=15

# n8n Integration Webhooks
N8N_DOCUMENT_ANALYSIS_WEBHOOK=http://localhost:5678/webhook/contractiq-analyze
N8N_REPORT_WEBHOOK=http://localhost:5678/webhook/contractiq-report

# Groq API Key (used by n8n or direct backend fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
